<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TaskPad</AssemblyName>
    <RootNamespace>TaskPad</RootNamespace>
    <ApplicationIcon>assets\taskpad.ico</ApplicationIcon>
    <StartupObject>TaskPad.Program</StartupObject>
    <Version>1.1.0</Version>
    <Copyright>Copyright (c) 2026 ddatunashvili</Copyright>
    <Product>TaskPad</Product>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Embed AvalonEdit inside the exe so it stays a single portable file -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgAvalonEdit)\lib\net462\ICSharpCode.AvalonEdit.dll" LogicalName="ICSharpCode.AvalonEdit.dll" />
    <Resource Include="assets\taskpad.ico" />
  </ItemGroup>

</Project>
